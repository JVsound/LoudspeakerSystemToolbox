# Autosave files
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*

# Derived content-obscured files
*.p

# Compiled MEX files
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Deployable archives
*.ctf

# Generated helpsearch folders
helpsearch*/

# Code generation folders
slprj/
sccprj/
codegen/

# Cache files
*.slxc

# Cloud based storage dotfile
.MATLABDriveTag

# Package and cache of buildtool (buildfile.m)
release/
.buildtool/

# Personal settings of Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Test report with the figures of the tests (generateHTMLReport), made again after each test run
tests/testreport/

# Scratch folder for temporary work (scripts, Ansys runs, intermediate results)
scratch/

# Files that Ansys creates when it solves the FEA models of the tests: results, solver output, caches and session
# journals. The project and the models stay in git; runAnsysFea creates these files again.
tests/**/fea/**/_ProjectScratch/
tests/**/fea/**/.project_cache
tests/**/fea/**/session_files/
tests/**/fea/**/*.rst
tests/**/fea/**/ds.dat
tests/**/fea/**/solve.out
tests/**/fea/**/file*.err
tests/**/fea/**/CAERep.xml
tests/**/fea/**/MatML.xml
